# Copy to .env.local and fill in. `npm run check:env` lists what is set and what each missing setting turns off.

# Supabase (required). For local development, `npx supabase status` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-anon-key-from-supabase-status
# Server only, never NEXT_PUBLIC_. Needed for AI usage limits, payments and deleting accounts.
SUPABASE_SERVICE_ROLE_KEY=

# The public address of the app (required): confirmation emails, the sitemap and link previews use it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the Terms and Privacy pages. Leave unset to show no contact address.
NEXT_PUBLIC_SUPPORT_EMAIL=

# AI features (server only). Leave unset to turn AI off (PDF import falls back to plain text).
OPENAI_API_KEY=

# Recommended videos (server only). Optional: without it, videos come from the web search instead.
# Create a key in Google Cloud (YouTube Data API v3). Each topic search costs about 101 of the 10,000 free daily units.
YOUTUBE_API_KEY=

# Payments with Paystack (server only). Leave unset to hide the upgrade screens.
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_MONTHLY=
PAYSTACK_PLAN_YEARLY=
